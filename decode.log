off chcp 65001  echo ========================================== echo 诊断: 原始订阅源内容与 Base64 合法性 ========================================== echo. REM 下载原始内容到二进制文件（避免文本模式截断） echo [1] 下载原始订阅源... curl -s -o sub.bin --max-time 30 --globoff "https://whua-bp.8dy.xx.kg/sub/normal/wh898?app=xray" echo. echo [2] 基本文件信息... for %F in (sub.bin) do echo 文件大小: %~zF bytes echo 创建时间: %~tF REM 检查是否为空 if %~zF EQU 0 ( echo 空文件，无法继续分析 pause exit /b 1 ) echo. echo [3] 尝试 Base64 解码（通过 certutil）... REM 输出到临时文件，不atter 是否成功 copy /y NUL decode.log  certutil -decode sub.bin sub.b64.txt  set "cert_rc=0" echo certutil 返回码:  if  EQU 0 ( echo [OK] certutil 解码成功，输出 sub.b64.txt ) else ( echo [FAIL] certutil 解码失败，查看 decode.log ) echo. echo [4] 视图：前 128 字节 Hex + 字符（避免直接输出二进制导致终端异常）... powershell -NoProfile -Command  "Get-Content -Path 'sub.bin' -Encoding Byte -TotalCount 128 | ^ ForEach-Object -Begin {$i=0;$hex='';$asc=''} -Process { ^ $hex += ('{0:X2} ' -f $_); ^ $asc += if ($_ -ge 32 -and $_ -le 126) {[char]$_} else {'.'}; ^ if (++$i -eq 16) { Write-Output ('{0:X4}  {1}  {2}' -f ($i-16), $hex, $asc); $i=0; $hex=''; $asc='' } } -End { if ($i -gt 0) { while ($i -lt 16) { $hex += '   '; $i++ }; Write-Output ('{0:X4}  {1}  {2}' -f 0, $hex, $asc) } } " echo. echo [5] 常见特征检测（前 64 字节中的可打印 ASCII 比例）... powershell -NoProfile -Command  "$data = Get-Content -Path 'sub.bin' -Encoding Byte -TotalCount 64; ^ $printable = ($data | Where-Object { $_ -ge 32 -and $_ -le 126 }).Count; ^ Write-Host ('可打印 ASCII 字符数: {0} / {1}' -f $printable, $data.Length); " echo. echo [6] 是否为 URL / HTML / JSON 文本特征... powershell -NoProfile -Command  "$data = Get-Content -Path 'sub.bin' -Encoding Byte -TotalCount 1024; ^ $text = [Text.Encoding]::UTF8.GetString($data); ^ $isHttp = $text.StartsWith('HTTP/'); ^ $isHtml = $text.Contains('<html'); ^ $isUrl  = $text.StartsWith('http://') -or $text.StartsWith('https://'); ^ Write-Host ('HTTP 行: {0}' -f $isHttp); ^ Write-Host ('HTML : {0}' -f $isHtml); ^ Write-Host ('URL  : {0}' -f $isUrl); ^ if ($text.StartsWith('data:')) { Write-Host 'DATA-URI: True' } " echo. echo [7] 小结... if  EQU 0 ( echo 原始内容可被 Base64 解码，进入下一步：解码后检视协议头。 ) else ( echo 原始内容看起来不是干净 Base64，进入下一步：hex 视图检查实际格式。 ) echo. echo [8] 原始 HTTP 头部（仅原始文件的前几行，若有）... powershell -NoProfile -Command  "Get-Content -Path 'sub.bin' -Encoding UTF8 -TotalCount 5 | ForEach-Object { Write-Output $_ } " echo. echo 诊断完成。 pause
